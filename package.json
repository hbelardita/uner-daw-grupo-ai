{
  "name": "uner-daw-grupo-ai",
  "version": "1.0.0",
  "description": "Repositorio de trabajos prácticos de la cátedra **Desarrollo de Aplicaciones Web** — Tecnicatura Universitaria en Desarrollo Web (Facultad de Ciencias de la Administración, UNER).",
  "main": "index.js",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "setup:env": "node -e \"const fs=require('fs'), p='tp-final-integrador/backend/.env'; if(!fs.existsSync(p)){ fs.copyFileSync(p+'.example', p); console.log('✓ .env creado desde .env.example'); } else { console.log('ℹ .env ya existe'); }\"",
    "postinstall": "npm run setup:env && npm --prefix tp-final-integrador/backend install",
    "dev:backend": "npm --prefix tp-final-integrador/backend run start:dev",
    "build:backend": "npm --prefix tp-final-integrador/backend run build",
    "lint:backend": "npm --prefix tp-final-integrador/backend run lint",
    "test:backend": "npm --prefix tp-final-integrador/backend run test",
    "test:backend:e2e": "npm --prefix tp-final-integrador/backend run test:e2e",
    "db:up": "npm --prefix tp-final-integrador/backend run db:up",
    "db:down": "npm --prefix tp-final-integrador/backend run db:down",
    "db:status": "npm --prefix tp-final-integrador/backend run db:status",
    "db:logs": "npm --prefix tp-final-integrador/backend run db:logs",
    "db:reset": "npm --prefix tp-final-integrador/backend run db:reset",
    "db:reset:test": "npm --prefix tp-final-integrador/backend run db:reset:test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbelardita/uner-daw-grupo-ai-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hbelardita/uner-daw-grupo-ai-/issues"
  },
  "homepage": "https://github.com/hbelardita/uner-daw-grupo-ai-#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  }
}
